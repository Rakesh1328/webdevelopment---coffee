
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <!-- Makes the page responsive on mobile -->
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Green Bean Café</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>

  <!-- NAVIGATION -->
  <header>
    <h2 class="logo">Green Bean Café</h2>
    <nav>
      <a href="#menu">Menu</a>
      <a href="#specials">Specials</a>
      <a href="#reviews">Reviews</a>
      <a href="#visit">Visit</a>
    </nav>
  </header>

  <!-- WELCOME / HERO -->
  <section class="hero">
    <h1>Fresh coffee. Slow mornings.</h1>
    <p>Welcome to Green Bean Café, Vijayawada. Pull up a chair.</p>
    <a class="btn" href="#menu">See the menu</a>
  </section>

  <!-- MENU -->
  <section id="menu">
    <h2>Our Menu</h2>

    <div class="cards">
      <div class="card">
        <h3>Filter Coffee</h3>
        <p>Strong, hot and frothy.</p>
        <b>₹60</b>
      </div>

      <div class="card">
        <h3>Cold Brew</h3>
        <p>Steeped for 18 hours.</p>
        <b>₹140</b>
      </div>

      <div class="card">
        <h3>Veg Sandwich</h3>
        <p>Grilled with mint chutney.</p>
        <b>₹110</b>
      </div>

      <div class="card">
        <h3>Chocolate Brownie</h3>
        <p>Warm, with ice cream.</p>
        <b>₹150</b>
      </div>
    </div>
  </section>

  <!-- SPECIAL ITEMS -->
  <section id="specials" class="dark">
    <h2>Today's Specials</h2>
    <p>
      Jaggery Latte: ₹120 |
      Mango Cheesecake: ₹180 |
      Combo (coffee + sandwich): ₹150
    </p>
  </section>

  <!-- REVIEWS -->
  <section id="reviews">
    <h2>What Customers Say</h2>

    <div class="cards">
      <div class="card">
        <p>"Best cold brew in town!"</p>
        <b>Ravi</b>
      </div>

      <div class="card">
        <p>"Quiet place to study."</p>
        <b>Sneha</b>
      </div>

      <div class="card">
        <p>"Brownie was amazing."</p>
        <b>Kiran</b>
      </div>
    </div>
  </section>

  <!-- HOURS + LOCATION -->
  <section id="visit" class="dark">
    <h2>Visit Us</h2>
    <p>Open every day: 8:00 AM to 10:00 PM</p>
    <p>MG Road, Vijayawada, Andhra Pradesh</p>
    <p>Phone: 98765 43210</p>
  </section>

  <footer>
    © 2026 Green Bean Café
  </footer>

</body>
</html>


/* Basic reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Georgia, serif;
    color: #222;
    line-height: 1.6;
}

/* Navigation bar (Flexbox) */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 40px;
    background: #234236;
    color: white;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
}

nav a:hover {
    color: #f3c9a5;
}

/* Hero */
.hero {
    text-align: center;
    padding: 110px 20px;
    color: white;
    background: linear-gradient(135deg, #234236, #3f7a62);
}

.hero h1 {
    font-size: 2.8rem;
    margin-bottom: 12px;
}

.btn {
    display: inline-block;
    margin-top: 20px;
    padding: 12px 26px;
    background: #f3c9a5;
    color: #234236;
    text-decoration: none;
    border-radius: 30px;
}

/* Sections */
section {
    padding: 60px 40px;
    text-align: center;
}

section h2 {
    margin-bottom: 28px;
    color: #234236;
}

.dark {
    background: #234236;
    color: white;
}

.dark h2 {
    color: #f3c9a5;
}

/* Cards (CSS Grid) */
.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
}

.card {
    padding: 24px;
    border: 1px solid #ddd;
    border-radius: 10px;
}

.card h3 {
    margin-bottom: 8px;
}

footer {
    text-align: center;
    padding: 20px;
    background: #16291f;
    color: white;
}

/* Mobile layout */
@media (max-width: 768px) {
    header {
        flex-direction: column;
        gap: 10px;
    }

    nav a {
        margin: 0 8px;
    }

    .hero h1 {
        font-size: 2rem;
    }

    section {
        padding: 40px 20px;
    }
}
